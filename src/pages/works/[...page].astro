---
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import Layout from '../../layouts/Layout.astro';
import WorkCards from '../../components/works/WorkCards.astro';
import {getWorks} from '../../lib/works.mjs';
export async function getStaticPaths({paginate}){return paginate(await getWorks(),{pageSize:6});}
const {page}=Astro.props;
const url=(n) => n===1?'/works/':`/works/${n}/`;
const numbers=Array.from({length:page.lastPage},(_,i)=>i+1);
const title=`制作事例一覧${page.currentPage>1?'｜'+page.currentPage+'ページ目':''}｜鈴鹿Web制作`;
const canonical=new URL(url(page.currentPage),Astro.site).href;
const jsonLd=JSON.stringify({'@context':'https://schema.org','@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:title,description:title});
---
<Layout title={title} description={title} canonical={canonical} jsonLd={jsonLd}>
<main class="l-container"><h1>制作事例一覧</h1><WorkCards works={page.data}/>
{page.lastPage>1&&<nav aria-label="制作事例のページ切り替え">{page.currentPage>1&&<a href={url(page.currentPage-1)}>前へ</a>}{numbers.map((n) => (<a href={url(n)} aria-current={page.currentPage===n?'page':undefined}>{n}</a>))}{page.currentPage < page.lastPage&&<a href={url(page.currentPage+1)}>次へ</a>}</nav>}
<Breadcrumb siteUrl="https://suzu-shika.com" breadcrumbLists={[{name:"制作事例一覧",path:"/works/"},...(page.currentPage>1?[{name:page.currentPage+"ページ目",path:url(page.currentPage)}]:[])]}/></main>
</Layout>
<style>
main.l-container{padding-top:160px;padding-bottom:48px}h1{font-size:clamp(28px,4vw,40px);margin-bottom:48px}nav[aria-label="制作事例のページ切り替え"]{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:48px}nav[aria-label="制作事例のページ切り替え"] a{display:grid;place-items:center;min-width:44px;min-height:44px;border:1px solid var(--color-main);padding:8px}a[aria-current="page"]{background:var(--color-main);color:white}
</style>
