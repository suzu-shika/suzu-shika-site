---
const { buttonUrl, buttonText, buttonAriaLabel, buttonTarget } = Astro.props;
---


<a href={buttonUrl} target={buttonTarget} rel={buttonTarget === "_blank" ? "noopener noreferrer" : undefined} aria-label={buttonAriaLabel} class="c-button">{buttonText}</a>

<style is:global lang="scss">
  @use '../../styles/breakpoints' as *;

  .c-button {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding-block: 10px;
    padding-inline: 28px 22px;
    border-radius: 100px;
    border: 2px solid;
    background-color: var(--color-main);
    color: var(--color-bg-sub);
    font-weight: 700;
    letter-spacing: .03em;
    line-height: 1.6;

    &::after {
      content: "";
      width: 8px;
      height: 10px;
      margin-block-end: 3px;
      background-color: currentColor;
      clip-path: polygon(0 0, 0% 100%, 100% 50%);
      // position: absolute;
      // top: 0;
      // left: 0;
    }
  }
</style>
