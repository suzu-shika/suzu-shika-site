---
import Button from "./Button.astro";
const { ctaText01, ctaText02, ctaIcon } = Astro.props;
---

<section class="c-cta">
  <div class="l-container">
    <div class="c-cta-icon">
      <img src={ctaIcon} alt="" loading="lazy" decoding="async" width="40" height="40">
    </div>
    <h2 class="c-cta-text">{ctaText01}<br>{ctaText02}</h2>
    <div class="c-cta-btn">
      <Button
      buttonText="無料相談はこちら"
      buttonUrl="#contact"
      buttonAriaLabel="お問い合わせ・無料相談をする"
      />
    </div>
  </div><!-- /.l-container -->
</section>

<style is:global lang="scss">
  @use '../../styles/breakpoints' as *;

  .c-cta {
    padding-block: 48px;
    background-image: linear-gradient(180deg, rgb(251 244 232), rgb(227 210 185));
    text-align: center;
  }

  .c-cta-icon {
    display: grid;
    place-items: center;

    img {
      width: 40px;
    }
  }

  .c-cta-text {
    margin-block-start: 16px;
    color: var(--color-main);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.55;
  }

  .c-cta-btn {
    margin-block-start: 48px;
  }

  @include mq() {
    .c-cta {
      padding-block: 68px;
    }

    .c-cta-text {
      font-size: 24px;
      letter-spacing: .04em;
    }
  }
</style>
