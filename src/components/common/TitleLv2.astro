---
const { title } = Astro.props;
---

<h2 class="c-title-lv2">{title}</h2>

<style is:global lang="scss">
  @use '../../styles/breakpoints' as *;

  .c-title-lv2 {
    display: grid;
    gap: 0.25em;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: .03em;
    line-height: 1.4;

    &::after {
      content: "";
      width: 60px;
      height: 3px;
      background-color: var(--color-main);
    }
  }

  @include mq() {
    .c-title-lv2 {
      font-size: 32px;
      letter-spacing: .05em;

      &::after {
        width: 80px;
      }
    }
  }
</style>
