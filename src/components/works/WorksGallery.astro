---
const {work}=Astro.props;
import {richHtml} from "../../lib/rich-html.mjs";
import {workImageUrl} from "../../lib/work-image.mjs";
---
<div class="works-gallery">
  <div class="l-container">
    {(work.pcImage1||work.pcImage2||work.spImage1||work.spImage2)&&<div class="works-gallery-content">
      {(work.pcImage1||work.pcImage2)&&<ul class="works-gallery-pc-list">
        {work.pcImage1&&<li class="works-gallery-pc-item">
          {work.pcImage1&&<img src={workImageUrl(work.pcImage1,600)} alt={work.pcImage1Alt} loading="lazy" decoding="async" width="300" height="182">}
        </li>}
        {work.pcImage2&&<li class="works-gallery-pc-item">
          {work.pcImage2&&<img src={workImageUrl(work.pcImage2,600)} alt={work.pcImage2Alt} loading="lazy" decoding="async" width="300" height="182">}
        </li>}
      </ul>}
      {(work.spImage1||work.spImage2)&&<ul class="works-gallery-sp-list">
        {work.spImage1&&<li class="works-gallery-sp-item">
          {work.spImage1&&<img src={workImageUrl(work.spImage1,180)} alt={work.spImage1Alt} loading="lazy" decoding="async" width="90" height="180">}
        </li>}
        {work.spImage2&&<li class="works-gallery-sp-item">
          {work.spImage2&&<img src={workImageUrl(work.spImage2,180)} alt={work.spImage2Alt} loading="lazy" decoding="async" width="90" height="180">}
        </li>}
      </ul>}
    </div>}
    <div class="works-gallery-link">
      {work.siteUrl&&<a href={work.siteUrl} target="_blank" rel="noopener noreferrer">{work.title} 公式サイト<span class="u-visually-hidden">（新しいタブで開きます）</span></a>}
      <a href="/works/">制作実績一覧へ戻る</a>
    </div>
  </div><!-- /.l-container -->
</div>

<style lang="scss" is:global>
  @use '../../styles/breakpoints' as *;

  .works-gallery {
    margin-block-start: 36px;
  }

  .works-gallery-content {
    display: flex;
    flex-direction: column;
    gap: 100px;
  }

  .works-gallery-pc-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    padding: 0;
  }

  .works-gallery-pc-item {
    img {
      width: 100%;
      max-width: 280px;
    }
  }

  .works-gallery-sp-list {
    display: flex;
    justify-content: center;
    gap: 40px;
    padding: 0;
  }

  .works-gallery-link {
    margin-block-start: 64px;
    display: inline-flex;
    flex-direction: column;
    gap: 16px;

    a {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      line-height: 2;
      position: relative;

      &[target="_blank"]::before {
        content: "";
        width: 100%;
        height: 1px;
        background-color: currentColor;
        position: absolute;
        bottom: 4px;
        left: 0;
      }

      &:first-child::after {
        content: "";
        width: 18px;
        height: 16px;
        background-image: url(/assets/images/global/icon-external-link.svg);
        background-repeat: no-repeat;
        background-size: contain;
        background-position: center center;
      }

      &:last-child {
        text-decoration: underline;
        text-underline-offset: 6px;
        text-decoration-thickness: 1px;
      }
    }
  }

  @media screen and (min-width: 700px) {
    .works-gallery-content {
      flex-direction: row;
      gap: min(48px, calc(48 / 1060 * 100vw));
    }

    .works-gallery-pc-list {
      flex-direction: row;
      gap: min(32px, calc(32 / 1060 * 100vw));
    }

    .works-gallery-pc-item {
      img {
        max-width: 300px;
      }
    }

    .works-gallery-sp-list {
      gap: min(32px, calc(32 / 1060 * 100vw));
    }
  }

  @include mq() {
    .works-gallery {
      margin-block-start: 40px;
    }

    .works-gallery-link {
      margin-block-start: 80px;
    }
  }
</style>
