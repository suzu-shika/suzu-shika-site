---
import {richHtml} from '../../lib/rich-html.mjs';
const {works}=Astro.props;
---
<div class="top-works-list">{works.map(work => <a href={'/works/'+work.id} class="top-works-card"><div class="top-works-card-thumbnail"><img src={work.thumbnail.url} alt={work.thumbnailAlt} width="300" height="160" loading="lazy" decoding="async" /></div><div class="top-works-card-content"><div class="top-works-card-title"><span class="top-works-card-category">#{work.siteType}</span><h3 class="top-works-card-site-name">{work.title} 様</h3></div><div set:html={richHtml(work.cardPoints,'card')} /></div></a>)}</div>
<style lang="scss" is:global>
  @use "../../styles/breakpoints" as *;

  

  .top-works-list {
    display: grid;
    gap: 40px;
  }

  .top-works-card {
    display: flex;
    flex-direction: column;
    padding-block: 24px 32px;
    background-color: var(--color-white);
    box-shadow: 0 8px 24px 0 rgb(0 0 0 / 0.08);
  }

  .top-works-card-thumbnail {
    padding-inline: 20px;

    img {
      width: 100%;
      max-width: 400px;
      margin-inline: auto;
    }
  }

  .top-works-card-content {
    width: 100%;
    max-width: calc(400px + 32px * 2);
    max-width: 420px;
    padding-inline: 32px;
    margin-block: 20px auto;
    margin-inline: auto;
  }

  .top-works-card-title {
    display: grid;
  }

  .top-works-card-category {
    font-size: 11px;
  }

  .top-works-card-site-name {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.6;
  }

  .top-works-card-list {
    padding: 0;
    margin-block-start: 16px;
  }

  .top-works-card-item {
    display: grid;
    grid-template-columns: 4px 1fr;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    line-height: 2;

    &::before {
      content: "";
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background-color: var(--color-main);
    }
  }

  @include mq() {
    .top-works-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 1024px) {
    .top-works-list {
      grid-template-columns: repeat(3, 1fr);
      gap: min(56px, calc(56 / var(--width-pc) * 100vw));
    }
  }

  @media (any-hover: hover) {
    .top-works-card {
      img {
        transition: scale 0.3s ease;
      }

      &:hover {
        .top-works-card-thumbnail {
          overflow: hidden;
        }

        img {
          scale: 1.03;
        }
      }
    }
  }
</style>
