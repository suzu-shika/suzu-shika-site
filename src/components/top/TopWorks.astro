---
import TitleLv2 from '../common/TitleLv2.astro';
import Button from '../common/Button.astro';
import WorkCards from '../works/WorkCards.astro';
import {getWorks} from '../../lib/works.mjs';
const featured=(await getWorks()).filter(w=>w.featured);
if(featured.length>3) console.warn('featured exceeds 3:',featured.slice(3).map(w=>w.id).join(','));
---
<section class="top-works" id="works"><div class="l-container"><div class="l-section-top"><TitleLv2 title="制作事例"/><div class="l-section-body-top">{featured.length>0&&<WorkCards works={featured.slice(0,3)}/>}<div class="works-more"><Button buttonUrl="/works/" buttonText="制作事例をもっと見る"/></div></div></div></div></section>
<style>.top-works{background-color:var(--color-sub)}.works-more{text-align:center;margin-top:48px}</style>